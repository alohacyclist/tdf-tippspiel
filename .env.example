# Frontend (Vite) — only the anon key, NEVER the service-role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Pipeline / GitHub Actions only (set as repo secrets, never VITE_-prefixed, never in the browser bundle):
# SUPABASE_URL=...
# SUPABASE_SERVICE_ROLE_KEY=...
# RESEND_API_KEY=...
